# Required in production
SESSION_SECRET=replace-with-a-long-random-string
PUBLIC_BASE_URL=https://your-domain.vercel.app

# Twilio. Without these, texts are kept in the trainer's text log and /dev/inbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vercel KV / Upstash. Required on Vercel so bookings persist.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
